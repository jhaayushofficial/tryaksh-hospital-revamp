##############################################################################
# Clinic Appointment System — configuration
#
# CHANGED FROM THE ORIGINAL DRAFT: doctors, clinics, and which doctor visits
# which clinic used to live entirely in this file. They now live in the
# database (`doctors`, `clinics`, `doctor_clinics` tables) and are edited
# from the admin dashboard — no redeploy needed to add a doctor, change a
# bio, or fix a clinic's address.
#
# This file now holds only what a .env file is normally for: secrets and
# machine-level settings. Copy it to .env and fill it in. The app checks it
# at startup and refuses to start, with a clear message, if anything is
# missing or wrong.
##############################################################################


# ── how the app runs ────────────────────────────────────────────────────────
APP_ENV=production                       # local | staging | production
PORT=8080
BASE_URL=https://tryaksh.com
DATABASE_URL=postgres://user:pass@localhost:5432/tryaksh?sslmode=disable
SESSION_SECRET=                          # 32+ random bytes. Signs the login cookie.
TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=https://tryaksh.com


# ── booking rules ───────────────────────────────────────────────────────────
# These are the only numbers that control how booking behaves. None of them
# appear anywhere in the code, and none of them depend on any specific
# doctor or clinic.

SLOT_DURATION_MINUTES=15                 # every appointment is this long
BOOKING_WINDOW_DAYS=30                   # how far ahead a patient can book
MIN_LEAD_TIME_MINUTES=60                 # hide slots starting sooner than this
CANCELLATION_WINDOW_HOURS=6              # patients can cancel up to this far ahead
MAX_BOOKINGS_PER_PHONE_PER_DAY=2
RATE_LIMIT_BOOKINGS_PER_HOUR_PER_IP=5
RATE_LIMIT_LOOKUPS_PER_MIN_PER_IP=5


# ── phone verification ──────────────────────────────────────────────────────
# Patients type a 6-digit code before an appointment is created. Since nothing
# is paid online, this is what proves a booking is real. A working channel is
# REQUIRED in production.
#
# Use OTP_CHANNEL=console while developing. It prints the code to your
# terminal instead of sending it, so you can build while approval is pending.

OTP_CHANNEL=whatsapp                     # whatsapp | sms | console
OTP_FALLBACK_CHANNEL=                    # leave empty to skip; 'sms' needs DLT
OTP_LENGTH=6
OTP_TTL_SECONDS=300                      # code valid for 5 minutes
OTP_MAX_ATTEMPTS=5                       # wrong tries before the code dies
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_PHONE_PER_HOUR=3
OTP_MAX_PER_IP_PER_HOUR=10
OTP_VERIFICATION_VALID_DAYS=30           # device remembers a verified number
OTP_PEPPER=                              # 32+ random bytes, mixed into the hash
OTP_REQUIRED_FOR_CANCEL=true

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=

# Only needed if a channel above is set to 'sms'
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=


# ── clinic-wide details shown on the website ────────────────────────────────
# Only the handful of things that are genuinely global — not tied to any one
# doctor or clinic. Everything else (doctor bios, clinic addresses, hours)
# is now in the database and edited from the dashboard, not here.

CLINIC_NAME=Tryaksh Hospital and Diagnostics
CLINIC_TAGLINE=Trusted family healthcare in Darbhanga
CLINIC_PHONE=+919229333922
CLINIC_WHATSAPP=+919229333922
CONSULTATION_FEE_DISPLAY=Payable at the clinic


# ── the shared admin login ──────────────────────────────────────────────────
# One password, shared by all doctors — there are no separate accounts and
# no roles, and there's no database table for this at all. The password is
# fixed on purpose: to change it, edit this line and redeploy.
#
# The app hashes this once (argon2id) when it starts and keeps the hash in
# memory only — never written to the database or to logs. Restarting the app
# for any reason, including a password change, signs out every device for
# every doctor as a side effect.
#
# Each doctor picks "who am I" right after logging in — that's just a label
# for the dashboard and the activity log, not a second password.

ADMIN_LOGIN_PASSWORD=admin


# ── confirmation messages (optional) ────────────────────────────────────────
# The system works fine with all of these off. The patient sees a reference
# number on screen, and that is their confirmation.

NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=appointments@tryaksh.com
REMINDER_HOURS_BEFORE=24                 # comma-separated, e.g. 24,2


# ── optional extras ─────────────────────────────────────────────────────────
SENTRY_DSN=

# Logs are structured (one record per event) and every record produced while
# serving a request carries its request_id, so a single failure can be traced
# end to end. The same id is returned in the X-Request-Id response header and
# in the body of any 500.
LOG_LEVEL=info                           # debug | info | warn | error
LOG_FORMAT=json                          # json for shipped logs, text for local reading


##############################################################################
# NOTE ON SEEDING THE DATABASE
#
# Doctors and clinics are no longer defined here. On first setup, seed them
# with a migration or a one-off admin-dashboard session instead — e.g. insert
# rows into `clinics`, then `doctors`, then link them via `doctor_clinics`.
# There is no "app refuses to start if a slug is missing" check anymore: the
# foreign keys from `availability` and `appointments` to `doctors`/`clinics`
# make that class of error impossible at the database level.
##############################################################################
